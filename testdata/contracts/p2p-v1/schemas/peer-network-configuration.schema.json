{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperboat.dev/contracts/p2p-v1/peer-network-configuration.schema.json",
  "title": "Paperboat signed peer network configuration v1 (decoded JWT payload)",
  "description": "EdDSA JWT type paperboat-network-config+jwt, maximum encoded token 128 KiB. Consumer additionally enforces signatures, local key/certificate identity, exact generations, unique addresses/keys/endpoints, 128 scopes total, direction, expiry and account scope. No relay authority is granted by this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "iss",
    "aud",
    "iat",
    "exp",
    "generation",
    "self",
    "peers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "iss": {
      "type": "string",
      "format": "uri"
    },
    "aud": {
      "const": "paperboat-network"
    },
    "iat": {
      "$ref": "#/$defs/generation"
    },
    "exp": {
      "$ref": "#/$defs/generation"
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "self": {
      "$ref": "#/$defs/binding"
    },
    "peers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/peer"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "endpoint_id",
        "role",
        "machine_id",
        "endpoint_generation",
        "machine_generation",
        "key_generation",
        "wireguard_public_key",
        "disco_public_key",
        "quic_certificate_fingerprint",
        "quic_public_key",
        "virtual_address"
      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/id"
        },
        "endpoint_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "cli",
            "machine"
          ]
        },
        "machine_id": {
          "type": "string",
          "maxLength": 256
        },
        "endpoint_generation": {
          "$ref": "#/$defs/generation"
        },
        "machine_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "key_generation": {
          "$ref": "#/$defs/generation"
        },
        "wireguard_public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "disco_public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "quic_certificate_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quic_public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "virtual_address": {
          "type": "string",
          "format": "ipv6",
          "pattern": "^fd7a:115c:a1e0:"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "cli"
              }
            }
          },
          "then": {
            "properties": {
              "machine_id": {
                "const": ""
              },
              "machine_generation": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "machine_id": {
                "$ref": "#/$defs/id"
              },
              "machine_generation": {
                "$ref": "#/$defs/generation"
              }
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_kind",
        "resource_id",
        "resource_generation",
        "capability",
        "direction",
        "port",
        "expires_at"
      ],
      "properties": {
        "resource_kind": {
          "enum": ["machine_access", "codex_session"]
        },
        "resource_id": {
          "$ref": "#/$defs/id"
        },
        "resource_generation": {
          "const": 1
        },
        "capability": {
          "enum": [
            "terminal",
            "file_transfer",
            "private_access",
            "codex"
          ]
        },
        "direction": {
          "enum": [
            "dial",
            "accept"
          ]
        },
        "port": {
          "const": 443
        },
        "expires_at": {
          "$ref": "#/$defs/generation"
        }
      },
      "allOf": [{"oneOf": [
        {"properties": {"resource_kind": {"const": "machine_access"}, "capability": {"enum": ["terminal", "file_transfer", "private_access"]}}},
        {"properties": {"resource_kind": {"const": "codex_session"}, "capability": {"const": "codex"}}}
      ]}]
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "scopes"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/binding"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/scope"
          }
        }
      }
    }
  }
}
